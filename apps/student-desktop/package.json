{
  "name": "student-desktop",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "build:renderer": "tsc && vite build",
    "build:native": "node scripts/build-native.cjs",
    "dist:win": "electron-builder install-app-deps && npm run build:native && npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "lucide-react": "^1.21.0",
    "node-addon-api": "^8.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.3.1",
    "win-audio": "^3.0.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "42.11.18",
    "electron-builder": "^26.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "node-gyp": "^12.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "main": "dist-electron/main.js"
}
