{
  "appId": "org.contx.student",
  "productName": "Contx Desktop",
  "executableName": "ContxDesktop",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/.env*"
  ],
  "extraResources": [
    {
      "from": "electron/native/mingw",
      "to": "mingw",
      "filter": ["**/*"]
    },
    {
      "from": "electron/native/keyboard-hook/build/Release/keyboard_hook.node",
      "to": "native/keyboard_hook.node"
    }
  ],
  "asarUnpack": [
    "**/*.node",
    "**/*.dll"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Contx-Desktop-${version}-Windows-x64-Setup.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Contx Desktop"
  }
}